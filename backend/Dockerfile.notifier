FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-notifier.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-notifier.txt

COPY . .

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV MINERWATCH_API_URL=http://api:8000/api/v1
ENV NOTIFIER_POLL_SECONDS=10

CMD ["python", "-m", "app.notifiers.poll_client"]
