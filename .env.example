# MinerWatch Environment Configuration

# Application
DEBUG=false
APP_NAME=MinerWatch

# Bittensor / Subtensor
BITTENSOR_NETWORK=finney
DEFAULT_SUBNET=97
POLL_INTERVAL_SECONDS=2
METAGRAPH_SYNC_INTERVAL_SECONDS=45
SLOT_SCAN_INTERVAL_SECONDS=15
MECHID=0

# Database
DATABASE_URL=postgresql+asyncpg://minerwatch:minerwatch@localhost:5432/minerwatch

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka (optional)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=minerwatch.events

# Optional market / TaoStats
# TAOMARKETCAP_API_KEY=
# TAOSTATS_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Notifications — Slack (#albedo) — REQUIRED for alerts
NOTIFICATIONS_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/TEAM/YOUR_TOKEN
SLACK_CHANNEL=#albedo
SLACK_APP_NAME=Albedo_Notification
NOTIFICATION_REG_FEE_THRESHOLDS_TAO=1.0,0.75,0.6
ALBEDO_NOTIFICATION_POLL_SECONDS=1
NOTIFICATION_REG_FEE_POLL_SECONDS=30
NOTIFICATION_GRACE_SECONDS=300
NOTIFICATION_MIN_HUB_INDEX_PROBES=0
NOTIFICATION_STARTUP_MAX_SECONDS=600
# NOTIFICATION_SKIP_STARTUP_GRACE=false
