# MinerWatch Environment Configuration

# Application
DEBUG=false
APP_NAME=MinerWatch

# Bittensor / Subtensor
BITTENSOR_NETWORK=finney
DEFAULT_SUBNET=1
POLL_INTERVAL_SECONDS=30
MECHID=0

# Database
DATABASE_URL=postgresql+asyncpg://minerwatch:minerwatch@localhost:5432/minerwatch

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka (optional)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=minerwatch.events

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
