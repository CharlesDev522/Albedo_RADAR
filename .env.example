# MinerWatch Environment Configuration

# Application
DEBUG=false
APP_NAME=MinerWatch

# Bittensor / Subtensor
BITTENSOR_NETWORK=finney
DEFAULT_SUBNET=97
POLL_INTERVAL_SECONDS=5
METAGRAPH_SYNC_INTERVAL_SECONDS=60
FULL_SCAN_INTERVAL_SECONDS=300
MECHID=0

# Notifications (Slack) — see NOTIFICATIONS.md
NOTIFICATIONS_ENABLED=true
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#albedo
SLACK_APP_NAME=Albedo_Notification

# GitHub repo tracking (collector background loop + Repo activity panel)
GITHUB_REPO_TRACKING_ENABLED=true
GITHUB_REPO_WATCHES=["https://github.com/tony-dendrite/albedo/tree/dev"]
GITHUB_POLL_INTERVAL_SECONDS=25
# Optional — raises GitHub API rate limit from 60/hr to 5000/hr
# GITHUB_TOKEN=

# Albedo subnet dashboard (temporary R2 mirror; restore https://albedo.tech when live)
ALBEDO_DASHBOARD_URL=https://pub-e2a73e9642e74a2ea78d2910c7a86025.r2.dev

SLOT_SCAN_INTERVAL_SECONDS=8
REPO_TRACK_INTERVAL_SECONDS=45
POLL_INTERVAL_SECONDS=3

# Database
DATABASE_URL=postgresql+asyncpg://minerwatch:minerwatch@localhost:5432/minerwatch

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka (optional)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=minerwatch.events

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
