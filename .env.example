# MinerWatch Environment Configuration

# Application
DEBUG=false
APP_NAME=MinerWatch

# Bittensor / Subtensor
BITTENSOR_NETWORK=finney
DEFAULT_SUBNET=97
POLL_INTERVAL_SECONDS=5
METAGRAPH_SYNC_INTERVAL_SECONDS=60
FULL_SCAN_INTERVAL_SECONDS=300
MECHID=0

# Database
DATABASE_URL=postgresql+asyncpg://minerwatch:minerwatch@localhost:5432/minerwatch

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka (optional)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=minerwatch.events

# Optional market / TaoStats
# TAOMARKETCAP_API_KEY=
# TAOSTATS_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Notifications (Slack webhook + Windows desktop client)
NOTIFICATIONS_ENABLED=true
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SLACK_CHANNEL=#albedo-alerts
NOTIFICATION_REG_FEE_THRESHOLD_TAO=0.75
ALBEDO_NOTIFICATION_POLL_SECONDS=15

# Desktop notifier (Windows host or docker compose --profile notifier)
# MINERWATCH_API_URL=http://localhost:8000/api/v1
# NOTIFIER_POLL_SECONDS=10
# NOTIFIER_KINDS=crown_won,crown_lost,commit_new,reg_fee_low
# NOTIFIER_ACK=true
